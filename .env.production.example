# Pablito Sports — plantilla de variables de PRODUCCIÓN (Fase 0, 12_DEPLOY.md §14).
#
# Copiar a `.env.production` y completar. `.env.production` NUNCA se versiona
# (03_SEGURIDAD.md §18 — está en `.gitignore` vía `.env.*`).
#
# Uso:
#   docker compose -f docker-compose.prod.yml --env-file .env.production build
#   docker compose -f docker-compose.prod.yml --env-file .env.production run --rm migrate
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ---------------------------------------------------------------------------
# Obligatorias
# ---------------------------------------------------------------------------

# Selecciona ProductionConfig: DEBUG=False, SESSION_COOKIE_SECURE forzado a True,
# y validate() rechaza un SECRET_KEY placeholder o de menos de 32 caracteres.
FLASK_ENV=production

# Firma de sesiones y tokens CSRF. GENERAR uno único por entorno:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ~86 caracteres. Nunca reutilizar el de desarrollo. Nunca versionar.
SECRET_KEY=GENERAR-CON-secrets.token_urlsafe(64)

# Conexión a PostgreSQL por la red interna de Docker Compose.
# El host es el nombre del servicio (`postgres`), no `localhost`.
DATABASE_URL=postgresql://pablito:CAMBIAR-PASSWORD@postgres:5432/pablito

# Credenciales del contenedor PostgreSQL — deben cuadrar EXACTAMENTE con DATABASE_URL.
POSTGRES_USER=pablito
POSTGRES_PASSWORD=CAMBIAR-PASSWORD
POSTGRES_DB=pablito

# Ruta del volumen persistente de imágenes dentro del contenedor.
UPLOAD_FOLDER=/var/lib/pablito/uploads

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Dominio público del sitio, para URLs absolutas de Open Graph y sitemap.
# Efectivamente obligatorio en producción.
SITE_BASE_URL=https://ejemplo.com

# `server_name` de Nginx. El mismo dominio que SITE_BASE_URL (sin esquema).
# `_` = servidor por defecto (acepta cualquier Host) — sirve para probar en local.
NGINX_SERVER_NAME=ejemplo.com

# ---------------------------------------------------------------------------
# Superadministrador inicial (04_BASE_DATOS.md §11.3)
# ---------------------------------------------------------------------------
# Solo lo usa la PRIMERA `flask db upgrade` (migración 9a1c4e77b2d0). Obligatorio
# en el primer deploy. Cambiar la contraseña desde el panel tras el primer acceso.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@ejemplo.com
ADMIN_INITIAL_PASSWORD=CAMBIAR-antes-del-primer-deploy

# ---------------------------------------------------------------------------
# Proxy / IP real
# ---------------------------------------------------------------------------
# Saltos de proxy de confianza delante de Flask (03_SEGURIDAD.md §14.2).
#   1  → topología actual de producción: Nginx → Gunicorn.  << DEJAR EN 1 >>
#   2  → SOLO en la fase Cloudflare (§C7), cuando Cloudflare esté en modo proxy
#        delante de Nginx. NO cambiar antes de cerrar el firewall del origen.
TRUSTED_PROXY_COUNT=1

# Almacén compartido del contador de rate limiting (03_SEGURIDAD.md §14.4).
# OBLIGATORIA: la aplicación se NIEGA A ARRANCAR si falta o si apunta a
# `memory://`, porque con un almacén dentro del proceso cada worker lleva su
# propio contador y el límite declarado deja de ser el real.
# Por defecto apunta al servicio `redis` de docker-compose.prod.yml.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# Workers de Gunicorn. El contador de rate limiting ya vive en un almacén
# compartido (RATELIMIT_STORAGE_URI, §14.4), así que subir este número ya NO
# multiplica el límite efectivo. Se deja en 1 porque dimensionar los workers es
# una decisión de capacidad, no de seguridad, y no se ha medido todavía.
GUNICORN_WORKERS=1

# Tag de las imágenes construidas (rollback). Por defecto `latest`; los scripts
# de deploy usan el SHA corto de git.
IMAGE_TAG=latest

# Trazabilidad de errores. Vacío = desactivado.
SENTRY_DSN=

# NOTA: CORS_ORIGINS no se incluye — el backend no implementa CORS y producción
# es mismo-origen (Nginx sirve frontend y API bajo el mismo dominio).
