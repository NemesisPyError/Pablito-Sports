# -----------------------------------------------------------------------------
# Pablito Sports — Nginx de PRODUCCIÓN (REFERENCIA ANOTADA, no se despliega)
# -----------------------------------------------------------------------------
# La configuración REALMENTE DESPLEGABLE vive en:
#
#     nginx/prod/default.conf.template     (la usa docker-compose.prod.yml)
#
# Este archivo se conserva como referencia comentada de las decisiones de diseño
# (Fase 0). NO se monta en ningún compose. Si cambia algo aquí, revisar si
# aplica también a `nginx/prod/default.conf.template` y a `nginx/conf.d/default.conf`.
#
# Documenta lo que la configuración de desarrollo (conf.d/default.conf) deja
# deliberadamente fuera: terminación TLS, HSTS y una Content-Security-Policy
# estricta.
#
# Topología objetivo:
#   Internet → Cloudflare (proxy naranja, WAF, TLS) → Nginx (este archivo) → Flask
#
# Ajustes obligatorios antes de usar:
#   - server_name con el dominio real.
#   - rutas de certificado TLS (o "SSL Full (strict)" en Cloudflare + cert de origen).
#   - TRUSTED_PROXY_COUNT=2 en el backend (Cloudflare añade un salto sobre Nginx).
#   - revisar la CSP contra el build real del frontend antes de activarla.

map $http_user_agent $pablito_crawler {
    default 0;
    "~*facebookexternalhit" 1;
    "~*facebookcatalog"     1;
    "~*WhatsApp"            1;
    "~*Twitterbot"         1;
    "~*Discordbot"         1;
    "~*TelegramBot"        1;
    "~*LinkedInBot"        1;
    "~*Slackbot"           1;
    "~*Googlebot"          1;
    "~*bingbot"            1;
    "~*DuckDuckBot"        1;
    "~*Applebot"           1;
}

# Redirección a HTTPS. Si Cloudflare ya fuerza HTTPS, este bloque es redundante
# pero inofensivo (defensa en profundidad para accesos directos al origen).
server {
    listen 80;
    server_name TU_DOMINIO;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name TU_DOMINIO;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # 03_SEGURIDAD.md §12: no revelar la versión de Nginx (header `Server` y
    # páginas de error). Quitar el header por completo necesitaría `headers-more`.
    server_tokens off;

    # 03_SEGURIDAD.md §11.1 / §14.5: el límite real por archivo es 5 MB
    # (`MAX_CONTENT_LENGTH` de Flask). 6m = 5 MB + holgura para el sobre
    # multipart, de modo que Flask pueda emitir su propio 413 JSON en el margen
    # 5–6 MB; por encima lo corta Nginx con el mismo contrato (@error_413).
    client_max_body_size 6m;

    # --- Cabeceras de seguridad (03_SEGURIDAD.md §12) -----------------------
    # HSTS: SOLO válido bajo HTTPS. El valor de abajo es el del PRIMER escalón,
    # el mismo que emite `nginx/prod/default.conf.template` a través de
    # `nginx/hsts`, donde está escrito el plan de escalado completo.
    # `includeSubDomains` y `preload` NO se ponen todavía: ver ese archivo.
    add_header Strict-Transport-Security "max-age=86400" always;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()" always;

    # Content-Security-Policy. Punto de partida ESTRICTO para el SPA compilado
    # (sin Vite/HMR en producción). Verificar contra el bundle real y relajar
    # solo lo imprescindible:
    #   - 'self' para script y estilo del propio build.
    #   - img: 'self' data: para las imágenes servidas desde /uploads y los
    #     data-URI del favicon.
    #   - connect-src 'self' para las llamadas a /api/v1 del mismo origen.
    #   - frame-ancestors 'none' reemplaza a X-Frame-Options en navegadores
    #     modernos.
    # Si el build inyecta estilos en línea, preferir un hash/nonce antes que
    # 'unsafe-inline'. NUNCA usar 'unsafe-eval'.
    #   - script-src/frame-src suman challenges.cloudflare.com: el widget de
    #     Cloudflare Turnstile (verificación humana en el acceso a la tienda)
    #     carga su script desde ahí y se renderiza en un iframe propio.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;

    # --- Errores generados por Nginx (no los del upstream) ------------------
    # `proxy_intercept_errors` queda en `off`: los 4xx/5xx JSON de Flask (incluido
    # el 404 de `/api/v1/*`) pasan intactos. Estos handlers solo cubren el 413 por
    # `client_max_body_size` y la caída del upstream, con el mismo contrato AD-16.
    # Sin `add_header` propio: heredan las cabeceras de seguridad y la CSP del
    # nivel `server` (que llevan `always`).
    error_page 413 = @error_413;
    error_page 502 503 504 = @error_upstream;

    # S-09: 413 y 503 van SIN `Cache-Control`. `expires` no alcanza a los códigos
    # de error y un `add_header` descartaría las cabeceras heredadas (CSP
    # incluida); no hace falta, porque no son heurísticamente cacheables.
    location @error_413 {
        default_type application/json;
        return 413 '{"success":false,"data":null,"errors":[{"code":"payload_too_large","rule":null,"detail":"uploaded content exceeds the maximum size","field":null}],"meta":{"request_id":null}}';
    }

    location @error_upstream {
        default_type application/json;
        return 503 '{"success":false,"data":null,"errors":[{"code":"service_unavailable","rule":null,"detail":"service temporarily unavailable","field":null}],"meta":{"request_id":null}}';
    }

    # --- API, salud, SEO, sitemap, robots (idénticos a desarrollo) ----------
    location /api/v1/ { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location /health/ { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location /_seo/   { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location = /robots.txt  { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location = /sitemap.xml { proxy_pass http://backend; include /etc/nginx/proxy_params; }

    # --- Imágenes: solo la rama de derivados (AD-38) ------------------------
    location /uploads/ {
        alias /var/lib/pablito/uploads/derivatives/;
        access_log off;
        # S-09: UNA sola fuente. `expires` y `add_header Cache-Control` juntos
        # emiten cada uno la suya y la respuesta sale con dos cabeceras.
        add_header Cache-Control "public, max-age=31536000, immutable";
        # Un derivado faltante: 404 sin cuerpo, no la página HTML de Nginx.
        try_files $uri @uploads_missing;
    }

    location @uploads_missing {
        # El 404 SÍ es heurísticamente cacheable: acá la cabecera hace falta.
        add_header Cache-Control "no-store" always;
        internal;
        types { }
        default_type application/json;
        return 404 '{"success":false,"data":null,"errors":[{"code":"resource_not_found","rule":null,"detail":"resource not found or not visible","field":null}],"meta":{"request_id":null}}';
    }

    # --- SPA compilado ------------------------------------------------------
    # En producción el frontend es un build estático, no el dev server de Vite.
    # Servirlo desde disco con fallback a index.html (SPA routing).
    location / {
        root /var/www/pablito;
        try_files $uri /index.html;
    }
}

# -----------------------------------------------------------------------------
# PENDIENTE — se configura en CLOUDFLARE, NO acá (spec completa: 03_SEGURIDAD.md §23)
# -----------------------------------------------------------------------------
# Este archivo cubre lo que corresponde al origen (Nginx). Lo siguiente NO se
# resuelve en Nginx y queda para la fase Cloudflare, previa aprobación:
#
#   - DNS del dominio en modo *Proxied* (nube naranja).
#   - SSL/TLS = Full (strict) + Always Use HTTPS + HSTS en el edge.
#   - WAF gestionado (Cloudflare + OWASP core) y Bot Fight Mode.
#   - Rate limiting de edge: login (`/api/v1/admin/auth/login`), escrituras
#     (`/api/v1/admin/*`) y API pública (`/api/v1/*`).
#   - Bypass de caché para `/api/v1/*`.
#   - Firewall del VPS: aceptar :443 SOLO desde los rangos de Cloudflare
#     (si no, se puentea todo el edge).
#   - `TRUSTED_PROXY_COUNT=2` en el backend, en el MISMO despliegue que activa
#     el modo proxy de Cloudflare (Cloudflare añade un salto sobre Nginx).
#   - Restaurar IP real del visitante (`CF-Connecting-IP`), opcionalmente con
#     `ngx_http_realip_module` + `set_real_ip_from <rangos CF>`.
#   - "Under Attack Mode" como interruptor manual de emergencia (no permanente).
