# Pablito Sports — Nginx de PRODUCCIÓN, configuración DESPLEGABLE (Fase 0).
#
# La imagen oficial de Nginx renderiza este archivo a
# /etc/nginx/conf.d/default.conf con `envsubst` sobre /etc/nginx/templates/*.template.
# NGINX_ENVSUBST_FILTER="^NGINX_" (docker-compose.prod.yml) hace que SOLO se
# sustituyan variables NGINX_*  (${NGINX_SERVER_NAME}); las variables propias de
# Nginx ($host, $uri, $proxy_add_x_forwarded_for, ...) quedan intactas.
#
# Referencia anotada y decisiones de diseño: nginx/production.conf.example.
# Cloudflare NO se configura acá (03_SEGURIDAD.md §23).

upstream backend {
    server backend:8000;
}

# Detección de rastreadores (AD-09, 05_API.md §6.1): las personas reciben el SPA
# compilado; los rastreadores, el documento pre-renderizado de /_seo/*.
map $http_user_agent $pablito_crawler {
    default 0;

    "~*facebookexternalhit" 1;
    "~*facebookcatalog"     1;
    "~*WhatsApp"            1;
    "~*Twitterbot"          1;
    "~*Discordbot"          1;
    "~*TelegramBot"         1;
    "~*LinkedInBot"         1;
    "~*Slackbot"            1;
    "~*Googlebot"           1;
    "~*bingbot"             1;
    "~*DuckDuckBot"         1;
    "~*Applebot"            1;
}

# --- HTTP -> HTTPS ---------------------------------------------------------
# Con Cloudflare "Always Use HTTPS" (fase posterior) esto es redundante pero
# inofensivo: defensa en profundidad para accesos directos al origen.
server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;

    # S-13: el destino es el nombre CONFIGURADO, no `$host`.
    #
    # Con `$host` el destino lo elegía quien enviaba la petición: medido,
    # `Host: evil.example` devolvía `Location: https://evil.example/catalogo`.
    # Un navegador no puede falsificar su propio `Host`, así que por sí solo no
    # es explotable; lo que lo convierte en un problema es que un 301 **sí es
    # heurísticamente cacheable** (RFC 9111 §4.2.2): bastaba una petición del
    # atacante para que una caché compartida guardara la redirección a su sitio
    # y se la sirviera después a las víctimas. Por eso, además, `no-store`.
    #
    # `NGINX_SERVER_NAME` pasa a ser obligatoria en el compose: con el antiguo
    # valor por defecto `_` esta redirección apuntaría a `https://_/`, y es
    # mejor que el contenedor no arranque a que redirija a ninguna parte.
    add_header Cache-Control "no-store" always;
    return 301 https://${NGINX_SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # 03_SEGURIDAD.md §G / 12_DEPLOY.md: cert real de Let's Encrypt o el Origin
    # Certificate de Cloudflare. En local se usa uno autofirmado
    # (nginx/certs/generate-selfsigned.sh).
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 03_SEGURIDAD.md §12: no revelar la versión de Nginx.
    server_tokens off;

    # 03_SEGURIDAD.md §11.5: alineado con MAX_CONTENT_LENGTH = 5 MB de Flask.
    client_max_body_size 6m;

    root  /usr/share/nginx/html;
    index index.html;

    # --- Cabeceras de seguridad (03_SEGURIDAD.md §12) --------------------
    # A nivel `server` con `always`: las heredan todas las localizaciones que no
    # declaren su propio `add_header`, y acompañan también a las respuestas de
    # error. Las que sí declaran `add_header` (assets, uploads) re-incluyen
    # `security_headers` para no perderlas.
    add_header X-Frame-Options        "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy     "accelerometer=(), autoplay=(), bluetooth=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()" always;

    # HSTS: SOLO válido bajo HTTPS. El valor y su plan de escalado viven en un
    # único archivo, que las localizaciones que rompen la herencia de
    # `add_header` vuelven a incluir (ver el propio `hsts`).
    include /etc/nginx/hsts;

    # CSP para el SPA compilado. `style-src` incluye 'unsafe-inline' porque
    # Bootstrap/React inyectan estilos en línea; el resto es estricto.
    # VERIFICAR contra el bundle real de `npm run build`. NUNCA 'unsafe-eval'.
    #
    # S-13: el valor vive en `nginx/csp`, un único archivo, porque las
    # localizaciones que rompen la herencia de `add_header` tienen que volver a
    # incluirlo. La política es la misma; solo cambió dónde está escrita.
    include /etc/nginx/csp;

    # --- Errores que genera Nginx (no los del upstream) -----------------
    # `proxy_intercept_errors` queda en `off`: los 4xx/5xx JSON de Flask
    # (incluido el 404 de /api/v1/*) pasan intactos.
    error_page 413         = @error_413;
    error_page 502 503 504 = @error_upstream;

    location @error_413 {
        # Sin `Cache-Control` a propósito. `expires` no alcanza a los códigos de
        # error (solo 2xx/3xx) y un `add_header` descartaría las cabeceras
        # heredadas del `server`, **incluida la CSP**. No hace falta: 413 y 503
        # no son heurísticamente cacheables (RFC 9111 §4.2.2 no los lista), de
        # modo que ninguna caché conforme los guarda sin frescura explícita. El
        # 404 sí lo es, y por eso `@uploads_missing`/`@asset_missing` sí la llevan.
        default_type application/json;
        return 413 '{"success":false,"data":null,"errors":[{"code":"payload_too_large","rule":null,"detail":"uploaded content exceeds the maximum size","field":null}],"meta":{"request_id":null}}';
    }

    location @error_upstream {
        # Mismo motivo que en @error_413.
        default_type application/json;
        return 503 '{"success":false,"data":null,"errors":[{"code":"service_unavailable","rule":null,"detail":"service temporarily unavailable","field":null}],"meta":{"request_id":null}}';
    }

    # --- API, salud, SEO, sitemap, robots -> backend -------------------
    location /api/v1/ { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location /health/ { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location /_seo/   { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location = /robots.txt  { proxy_pass http://backend; include /etc/nginx/proxy_params; }
    location = /sitemap.xml { proxy_pass http://backend; include /etc/nginx/proxy_params; }

    # --- Derivación por agente (AD-09) ---------------------------------
    # Personas -> index.html (SPA compilado). Rastreadores -> documento de §6.2.
    location = / {
        # S-09: el documento HTML NO puede quedar cacheado sin revalidar.
        # `expires epoch` -> `Cache-Control: no-cache` (se puede guardar, pero
        # hay que revalidar siempre). Se usa `expires` y no `add_header` porque
        # `add_header` descartaría la CSP, HSTS y Permissions-Policy heredadas
        # del `server` (comprobado). Además esta URL devuelve DOS
        # representaciones según el User-Agent (persona / rastreador) y no hay
        # `Vary: User-Agent`: sin `no-cache`, una caché compartida podría
        # servirle a una persona el documento del rastreador.
        expires epoch;
        include /etc/nginx/proxy_params;
        if ($pablito_crawler) {
            rewrite ^ /_seo/catalog break;
            proxy_pass http://backend;
        }
        try_files /index.html =404;
    }

    location = /catalogo {
        # S-09: el documento HTML NO puede quedar cacheado sin revalidar.
        # `expires epoch` -> `Cache-Control: no-cache` (se puede guardar, pero
        # hay que revalidar siempre). Se usa `expires` y no `add_header` porque
        # `add_header` descartaría la CSP, HSTS y Permissions-Policy heredadas
        # del `server` (comprobado). Además esta URL devuelve DOS
        # representaciones según el User-Agent (persona / rastreador) y no hay
        # `Vary: User-Agent`: sin `no-cache`, una caché compartida podría
        # servirle a una persona el documento del rastreador.
        expires epoch;
        include /etc/nginx/proxy_params;
        if ($pablito_crawler) {
            rewrite ^ /_seo/catalog break;
            proxy_pass http://backend;
        }
        try_files /index.html =404;
    }

    location ~ ^/producto/(?<product_slug>[^/]+)$ {
        # S-09: el documento HTML NO puede quedar cacheado sin revalidar.
        # `expires epoch` -> `Cache-Control: no-cache` (se puede guardar, pero
        # hay que revalidar siempre). Se usa `expires` y no `add_header` porque
        # `add_header` descartaría la CSP, HSTS y Permissions-Policy heredadas
        # del `server` (comprobado). Además esta URL devuelve DOS
        # representaciones según el User-Agent (persona / rastreador) y no hay
        # `Vary: User-Agent`: sin `no-cache`, una caché compartida podría
        # servirle a una persona el documento del rastreador.
        expires epoch;
        include /etc/nginx/proxy_params;
        if ($pablito_crawler) {
            rewrite ^ /_seo/products/$product_slug break;
            proxy_pass http://backend;
        }
        try_files /index.html =404;
    }

    # --- Imágenes: solo la rama de derivados (AD-38) ------------------
    location /uploads/ {
        alias /var/lib/pablito/uploads/derivatives/;
        include /etc/nginx/security_headers;
        # `add_header Cache-Control` (abajo) descarta lo heredado del `server`:
        # sin esto, las imágenes se servían sin HSTS.
        include /etc/nginx/hsts;
        include /etc/nginx/csp;
        access_log off;
        # §15.7: nombre con huella de contenido -> cacheo indefinido sin invalidación.
        add_header Cache-Control "public, max-age=31536000, immutable";
        # Un derivado faltante: 404 JSON AD-16, no la página HTML de Nginx.
        try_files $uri @uploads_missing;
    }

    location @uploads_missing {
        internal;
        include /etc/nginx/security_headers;
        # `security_headers` ya declara cabeceras propias acá, así que lo
        # heredado queda descartado y HSTS hay que volver a ponerlo.
        include /etc/nginx/hsts;
        include /etc/nginx/csp;
        # Un derivado ausente no debe quedar guardado: durante un fallo de
        # montaje del volumen, el 404 se cachearía y la imagen no volvería.
        # `expires` NO sirve acá: solo actúa sobre 200/201/204/206/3xx, y esto es
        # un 404 (comprobado: con `expires epoch` la respuesta seguía saliendo
        # sin `Cache-Control`). Hace falta `add_header ... always`. Esta
        # localización ya rompe la herencia con `security_headers`, así que el
        # `add_header` no cuesta ninguna cabecera adicional.
        add_header Cache-Control "no-store" always;
        types { }
        default_type application/json;
        return 404 '{"success":false,"data":null,"errors":[{"code":"resource_not_found","rule":null,"detail":"resource not found or not visible","field":null}],"meta":{"request_id":null}}';
    }

    # --- Assets del build de Vite (nombres con hash) -> cache larga ---
    location /assets/ {
        include /etc/nginx/security_headers;
        # Igual que en `/uploads/`: el `Cache-Control` propio rompe la herencia.
        include /etc/nginx/hsts;
        include /etc/nginx/csp;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # `add_header` sin `always` solo alcanza a 2xx/3xx: el 404 salía sin
        # `Cache-Control` y un 404 SÍ es heurísticamente cacheable (RFC 9111
        # §4.2.2). Durante un despliegue, pedir un bundle que aún no aterrizó
        # dejaría el 404 guardado y el SPA roto hasta que caduque.
        error_page 404 = @asset_missing;
        try_files $uri =404;
    }

    location @asset_missing {
        internal;
        include /etc/nginx/security_headers;
        include /etc/nginx/hsts;
        include /etc/nginx/csp;
        # `expires` NO sirve acá: solo actúa sobre 200/201/204/206/3xx, y esto es
        # un 404 (comprobado: con `expires epoch` la respuesta seguía saliendo
        # sin `Cache-Control`). Hace falta `add_header ... always`. Se
        # incluyen las mismas cabeceras que `/assets/`, que ya rompe la herencia
        # por su propio `Cache-Control`: el 404 sale igual que el 200.
        add_header Cache-Control "no-store" always;
        return 404;
    }

    # --- Estáticos de `public/` (nombre SIN huella de contenido) ------
    # Fuentes y logos de bancos: cambian casi nunca, pero el nombre NO lleva
    # huella, así que no admiten `immutable` — si se reemplaza el archivo, la
    # URL es la misma. 30 días con revalidación al caducar es el punto medio;
    # antes salían sin `Cache-Control` y quedaban a merced de la heurística.
    location /fonts/ {
        expires 30d;
        try_files $uri /index.html;
    }

    location /banks/ {
        expires 30d;
        try_files $uri /index.html;
    }

    # --- SPA: cualquier otra ruta del cliente -> index.html ----------
    # El ETag por sí solo NO obliga a revalidar: sin `Cache-Control`, una caché
    # aplica frescura heurística sobre `Last-Modified` (RFC 9111 §4.2.2) y sirve
    # el HTML viejo SIN preguntar. Ese HTML referencia `/assets/<huella>.js` que
    # el despliegue nuevo ya borró, y el SPA queda roto hasta que caduque.
    # `no-cache` conserva el ETag (respuestas 304) pero exige revalidar siempre.
    location / {
        expires epoch;
        try_files $uri /index.html;
    }
}
