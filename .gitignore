# Secretos y entorno (03_SEGURIDAD.md §18)
.env
.env.*
!.env.example
!.env.production.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
.vite/

# Logs
*.log
logs/

# Volúmenes y subidas locales
uploads/
backups/

# Editores y sistema operativo
.idea/
.vscode/
.DS_Store
Thumbs.db

# Artefacto residual de Windows (nombre reservado de dispositivo, no se puede borrar)
nul

# Certificados locales de inspección TLS (no se versionan)
backend/certs/*.crt
frontend/certs/*.crt

# Certificados TLS de producción — NUNCA al repo (Fase 0, 12_DEPLOY.md §G).
# En un VPS real van certs de Let's Encrypt o el Origin Certificate de Cloudflare.
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt

# Uploads al correr el backend fuera de Docker (.vscode/launch.json)
.local-uploads/
