# Pablito Sports — plantilla de variables de entorno (12_DEPLOY.md §14).
# Copiar a `.env` y completar. `.env` NUNCA se versiona (03_SEGURIDAD.md §18).

# ---------------------------------------------------------------------------
# Obligatorias (12_DEPLOY.md §14.1)
# ---------------------------------------------------------------------------

# development | testing | production
FLASK_ENV=development

# Conexión PostgreSQL usada por la aplicación.
DATABASE_URL=postgresql://pablito:pablito@postgres:5432/pablito

# Base de datos dedicada a la ejecución de tests.
TEST_DATABASE_URL=postgresql://pablito:pablito@postgres:5432/pablito_test

# Firma de sesiones y tokens CSRF. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambiar-en-cada-entorno

# True en producción, False en desarrollo/testing (sin HTTPS local).
SESSION_COOKIE_SECURE=False

# Proxies de confianza delante de Flask (03_SEGURIDAD.md §14.2). ProxyFix toma
# la IP real, el esquema y el host SOLO de esta cantidad de saltos en
# `X-Forwarded-*`; un cliente que inyecte encabezados de más queda ignorado.
#   - 1  → topología actual: Nginx → Flask (desarrollo y producción sin CDN).
#   - 2  → con Cloudflare delante: Cloudflare → Nginx → Flask.
#   - 0  → desactiva ProxyFix (backend accedido sin proxy).
TRUSTED_PROXY_COUNT=1

# Almacén compartido del contador de rate limiting (03_SEGURIDAD.md §14.4).
# `memory://` guarda un contador POR WORKER de Gunicorn: el límite declarado
# deja de ser el real y se pierde en cada reinicio. `limits` no ofrece backend
# de PostgreSQL, así que hace falta un almacén externo.
#   - Con Compose: redis://redis:6379/0
#   - Si falta: desarrollo cae a `memory://`; PRODUCCIÓN SE NIEGA A ARRANCAR.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Almacén que usan los tests que encienden el rate limiting. Va en otra base
# para que `limiter.reset()` no borre los contadores de desarrollo. Si falta,
# los tests de contador compartido se saltan solos.
TEST_RATELIMIT_STORAGE_URI=redis://redis:6379/1

# Ruta del volumen persistente de imágenes (AD-05, DPL-04).
UPLOAD_FOLDER=/var/lib/pablito/uploads

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Superadministrador inicial (04_BASE_DATOS.md §11.3)
# ---------------------------------------------------------------------------
# La migración de semilla exige la contraseña por variable de entorno:
# 03_SEGURIDAD.md §18.2 prohíbe versionar credenciales. Mínimo 12 caracteres (§5.5).
#
# Sólo se usa al crear la base desde cero. La contraseña vigente vive en la tabla
# `administrators` (sólo el hash bcrypt); cambiarla desde el panel no obliga a
# tocar este archivo.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@pablitosports.local
ADMIN_INITIAL_PASSWORD=cambiar-antes-de-desplegar

# ---------------------------------------------------------------------------
# Credenciales del contenedor PostgreSQL (deben coincidir con DATABASE_URL)
# ---------------------------------------------------------------------------

POSTGRES_USER=pablito
POSTGRES_PASSWORD=pablito
POSTGRES_DB=pablito

# ---------------------------------------------------------------------------
# Opcionales (12_DEPLOY.md §14.2)
# ---------------------------------------------------------------------------

# CORS: no hay variable, a propósito (S-11, 02_ARQUITECTURA.md §16.6).
#
# Existía `CORS_ORIGINS`, pero **ningún código la leía**: Flask-CORS no está
# instalado y no hay implementación propia. Una variable que parece un control
# de seguridad y no lo es resulta peor que no tenerla, así que se retiró.
#
# El motivo de fondo es `AD-04`: Nginx sirve el SPA y la API bajo el MISMO
# origen, y el frontend llama a `/api/v1` con ruta relativa. No existe ninguna
# petición cross-origin, de modo que habilitar CORS solo abriría una superficie
# que hoy no hace falta. Si algún día se sirviera el frontend desde otro
# dominio, hay que decidirlo explícitamente, no reactivando esta línea.

# Trazabilidad de errores. Punto de extensión; vacío desactiva la integración.
SENTRY_DSN=

# Cloudflare Turnstile — verificación humana en el acceso a la tienda.
# Ambas quedan vacías por defecto: sin ellas el gate se desactiva solo (no se
# inventa ninguna credencial ni se rompe el entorno local — TurnstileService
# lo detecta y el frontend no muestra el widget). Deben quedar las DOS
# puestas o las DOS vacías: media configuración no arranca (ver
# `core/config/base.py::validate`).
#
#   - TURNSTILE_SITE_KEY: pública, la usa el frontend (VITE_TURNSTILE_SITE_KEY
#     más abajo) para dibujar el widget. Segura de exponer.
#   - TURNSTILE_SECRET_KEY: SOLO el backend. Nunca debe llegar al frontend ni
#     a ningún log — valida el token contra Cloudflare del lado del servidor.
#
# Se obtienen creando un sitio en https://dash.cloudflare.com/?to=/:account/turnstile
#
# `docker-compose.yml` copia TURNSTILE_SITE_KEY al VITE_TURNSTILE_SITE_KEY del
# contenedor `frontend` (las variables que Vite expone al navegador deben
# empezar con VITE_): con completar esta sola variable alcanza, no hace falta
# declararla dos veces.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Puertos publicados en la máquina del desarrollador
# ---------------------------------------------------------------------------

NGINX_PORT=8080
POSTGRES_PORT=5432
